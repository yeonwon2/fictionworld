  "title": "S\u1ef1 ki\u1ec7n / M\u1ed1c th\u1eddi gian",
  "properties": {
    "title": {
      "type": "string",
      "title": "T\u00ean s\u1ef1 ki\u1ec7n"
    },
    "timeline_order": {
      "type": "number",
      "title": "Th\u1ee9 t\u1ef1 th\u1eddi gian",
      "default": 0
    },
    "description": {
      "type": "string",
      "title": "M\u00f4 t\u1ea3"
    },
    "related_character_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Nh\u00e2n v\u1eadt li\u00ean quan (ids)",
      "default": []
    },
    "related_location_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "\u0110\u1ecba danh li\u00ean quan (ids)",
      "default": []
    },
    "participant_states": {
      "type": "object",
      "title": "Tr\u1ea1ng th\u00e1i nh\u00e2n v\u1eadt t\u1ea1i m\u1ed1c",
      "description": "B\u1ea3n \u0111\u1ed3 { character_id: tr\u1ea1ng th\u00e1i } t\u1ea1i s\u1ef1 ki\u1ec7n (b\u1ecb th\u01b0\u01a1ng, th\u0103ng c\u1ea5p, m\u1ea5t t\u00edch...).",
      "default": {}
    },
    "custom_fields": {
      "type": "object",
      "title": "Tr\u01b0\u1eddng t\u00f9y ch\u1ec9nh",
      "default": {}
    },
    "story_id": {
      "type": "string",
      "title": "B\u1ed9 truy\u1ec7n (id)"
    }
  },
  "required": [
    "title"
  ]
}