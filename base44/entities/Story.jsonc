{
  "name": "Story",
  "type": "object",
  "title": "B\u1ed9 truy\u1ec7n",
  "properties": {
    "name": {
      "type": "string",
      "title": "T\u00ean b\u1ed9 truy\u1ec7n",
      "description": "T\u00ean t\u00e1c ph\u1ea9m / b\u1ed9 truy\u1ec7n"
    },
    "genre": {
      "type": "string",
      "title": "Th\u1ec3 lo\u1ea1i",
      "description": "VD: Ti\u00ean hi\u1ec7p, Huy\u1ec1n huy\u1ec5n, Ki\u1ebfm hi\u1ec7p, \u0110\u00f4 th\u1ecb..."
    },
    "cover_url": {
      "type": "string",
      "title": "\u1ea2nh b\u00eca",
      "format": "uri"
    },
    "direction": {
      "type": "object",
      "title": "\u0110\u1ecbnh h\u01b0\u1edbng b\u1ed9 truy\u1ec7n (Story Direction)",
      "description": "Th\u00f4ng tin t\u00e1c gi\u1ea3 \u0111\u1ecbnh h\u01b0\u1edbng sau khi ch\u1ed1t \u00fd t\u01b0\u1edfng \u2014 d\u00f9ng l\u00e0m context cho m\u1ecdi l\u1ec7nh AI.",
      "default": {},
      "properties": {
        "lengthMode": {
          "type": "string",
          "title": "\u0110\u1ed9 d\u00e0i (suggest/custom)"
        },
        "customLength": {
          "type": "number",
          "title": "S\u1ed1 ch\u01b0\u01a1ng d\u1ef1 ki\u1ebfn"
        },
        "ending": {
          "type": "string",
          "title": "Ki\u1ec3u k\u1ebft th\u00fac"
        },
        "tones": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "T\u00f4ng truy\u1ec7n",
          "default": []
        },
        "emphasis": {
          "type": "object",
          "title": "T\u1ef7 l\u1ec7 nh\u1ea5n m\u1ea1nh",
          "properties": {
            "emotion": {
              "type": "number"
            },
            "plot": {
              "type": "number"
            },
            "action": {
              "type": "number"
            }
          }
        },
        "want": {
          "type": "string",
          "title": "\u0110i\u1ec1u mu\u1ed1n c\u00f3"
        },
        "avoid": {
          "type": "string",
          "title": "\u0110i\u1ec1u mu\u1ed1n tr\u00e1nh"
        }
      }
    },
    "form_schema": {
      "type": "object",
      "title": "C\u1ea5u h\u00ecnh tr\u01b0\u1eddng theo b\u1ed9 truy\u1ec7n",
      "description": "L\u01b0u nh\u00e3n \u0111\u00e3 \u0111\u1ed5i + danh s\u00e1ch tr\u01b0\u1eddng t\u00f9y ch\u1ec9nh cho t\u1eebng lo\u1ea1i form (character, location, event, relationship).",
      "default": {}
    }
  },
  "required": [
    "name"
  ]
}