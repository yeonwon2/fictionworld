{
  "name": "Location",
  "type": "object",
  "title": "\u0110\u1ecba danh",
  "properties": {
    "name": {
      "type": "string",
      "title": "T\u00ean \u0111\u1ecba danh"
    },
    "type": {
      "type": "string",
      "title": "Lo\u1ea1i",
      "enum": [
        "M\u00f4n ph\u00e1i",
        "V\u00f9ng \u0111\u1ea5t",
        "Qu\u1ed1c gia",
        "Th\u00e0nh tr\u00ec",
        "Kh\u00e1c"
