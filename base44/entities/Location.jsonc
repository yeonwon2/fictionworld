      "default": "Kh\u00e1c"
    },
    "map_url": {
      "type": "string",
      "title": "\u1ea2nh b\u1ea3n \u0111\u1ed3",
      "format": "uri"
    },
    "description": {
      "type": "string",
      "title": "M\u00f4 t\u1ea3"
    },
    "parent_location_id": {
      "type": "string",
      "title": "\u0110\u1ecba danh c\u1ea5p tr\u00ean (id)"
